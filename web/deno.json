{
  "tasks": {
    "build": "deno run -A build.ts",
    "build:watch": "deno run -A build.ts --watch",
    "dev": "deno run -A build.ts --watch & deno run -A server.ts",
    "fmt": "deno fmt src test build.ts server.ts",
    "lint": "deno lint src test build.ts server.ts",
    "stress": "deno run -A bench/stress_test.ts",
    "test": "deno test"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "imports": {
    "esbuild": "npm:esbuild@0.20.0",
    "esbuild-plugin-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.0",
    "@std/assert": "jsr:@std/assert@0.224.0",
    "@std/http": "jsr:@std/http@0.224.0",
    "@std/cli": "jsr:@std/cli@0.224.0",
    "deno_dom": "https://deno.land/x/deno_dom@v0.1.43/deno-dom-wasm.ts",
    "uplot": "npm:uplot@1.6.30",
    "katex": "npm:katex@0.16.11"
  }
}
