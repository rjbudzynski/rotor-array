<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rotor Array Simulation</title>
    <link rel="stylesheet" href="bundle.css">
    <link rel="icon" type="image/svg+xml" href="favicon.svg">
</head>
<body>
    <div id="app">
        <div id="canvas-container">
            <div id="canvas-stack">
                <canvas id="sim-canvas" class="sim-layer" width="400" height="400"></canvas>
                <canvas id="overlay-canvas" class="sim-layer" width="400" height="400"></canvas>
            </div>
        </div>
        <div id="sidebar">
            <h1>Rotor Array <button id="help-btn" title="Help">?</button></h1>

            <div id="controls-container">
                <!-- Controls will be injected here -->
            </div>

            <div class="control-group">
                <label>Mean Direction</label>
                <canvas id="mean-dir-canvas" class="mean-dir-canvas" width="240" height="240"></canvas>
            </div>

            <div class="control-group" id="color-bar-container">
            </div>

            <div class="control-group">
                <div class="value-display value-display-compact">
                    <span class="value-label">Energy (per rotor):</span>
                    <span id="energy-per-node-value">—</span>
                    <span class="value-sep"> | </span>
                    <span>dE/E0:</span>
                    <span id="energy-rel-dev-value">—</span>
                </div>
            </div>
            
            <div class="control-group">
                <div id="uplot-chart"></div>
            </div>

            <div class="sidebar-footer">
                <p>&copy; {{YEAR}} <a href="https://budzynski.xyz" target="_blank" rel="noopener">{{OWNER}}</a></p>
                <p>
                    Build: {{DATE}} (<a href="https://github.com/rjbudzynski/rotor-array/commit/{{HASH}}" target="_blank" rel="noopener">{{HASH}}</a>)
